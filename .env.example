# SimpleERP Environment Configuration
# Copy this file to .env and adjust values as needed

# ===========================================
# Application Settings
# ===========================================
SERP_APP_TITLE=SimpleERP
SERP_APP_VERSION=1.0.0
SERP_DEBUG=true

# ===========================================
# Server Settings
# ===========================================
SERP_HOST=0.0.0.0
SERP_PORT=8000
SERP_RELOAD=true

# ===========================================
# CORS Settings
# ===========================================
SERP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# Database Settings (PostgreSQL)
# ===========================================
# Docker Compose default
SERP_DATABASE_URL=postgresql+asyncpg://serp:serp@localhost:5432/serp

# Module-specific database URLs (optional, defaults to SERP_DATABASE_URL)
SERP_COMMON_DATABASE_URL=postgresql+asyncpg://serp:serp@localhost:5432/serp
SERP_CRM_DATABASE_URL=postgresql+asyncpg://serp:serp@localhost:5432/serp
SERP_USERS_DATABASE_URL=postgresql+asyncpg://serp:serp@localhost:5432/serp

# ===========================================
# Redis Settings
# ===========================================
SERP_REDIS_URL=redis://localhost:6379/0

# ===========================================
# Kafka Settings
# ===========================================
SERP_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SERP_KAFKA_CONSUMER_GROUP=serp-app

# ===========================================
# Authentication Settings
# ===========================================
# IMPORTANT: Change this in production!
SERP_SECRET_KEY=dev-secret-key-change-in-production
SERP_ALGORITHM=HS256
SERP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# Module Settings
# ===========================================
SERP_ENABLE_ALL_MODULES=true
# Or explicitly list modules:
# SERP_ENABLED_MODULES=["serp-users","serp-common","serp-crm"]
