[project]
name = "{{ module_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
authors = [
    { name = "{{ author }}", email = "your.email@example.com" }
]
license = { text = "MIT" }

dependencies = [
    "serp-core>=1.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
    "pytest-asyncio>=0.21.0",
    "black>=23.0.0",
    "ruff>=0.1.0",
]

[project.entry-points."serp.modules"]
{{ module_name }} = "{{ module_slug }}:MODULE_INFO"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{ module_slug }}"]
